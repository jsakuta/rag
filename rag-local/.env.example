# ===========================================
# RAG-Local 環境変数設定
# ===========================================
# このファイルを .env にコピーして値を設定してください
#
# 注意: 検索設定（top_k, vector_weight等）は config/settings.yaml で管理
#       ここには機密情報（APIキー等）のみを記載

# === GCP認証方式 ===
# "local"（デフォルト）: ローカルのサービスアカウントJSONファイルを使用
# "key_vault": Azure Key Vaultからサービスアカウント認証情報を取得
CREDENTIAL_SOURCE=local

# -------------------------------------------
# ローカル認証設定（CREDENTIAL_SOURCE=local の場合）
# -------------------------------------------
# サービスアカウントJSONファイルのパス（base_dirからの相対パス）
# GEMINI_CREDENTIALS_PATH=gemini_credentials.json

# -------------------------------------------
# Azure Key Vault設定（CREDENTIAL_SOURCE=key_vault の場合）
# -------------------------------------------
# AZURE_KEY_VAULT_URL=https://your-keyvault.vault.azure.net/
# AZURE_KEY_VAULT_SECRET_NAME=your-secret-name
# AZURE_KEY_VAULT_SCOPES=https://www.googleapis.com/auth/cloud-platform

# === プロバイダー固有設定 ===

# -------------------------------------------
# Azure OpenAI設定（埋め込みプロバイダーがazure_openaiの場合必須）
# -------------------------------------------
AZURE_OPENAI_API_KEY=your-api-key-here
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-large
AZURE_OPENAI_API_VERSION=2024-12-01-preview

# -------------------------------------------
# Vertex AI設定（LLMまたは埋め込みでGeminiを使う場合必須）
# -------------------------------------------
GEMINI_PROJECT_ID=your-project-id
GEMINI_LOCATION=us-central1
VERTEX_AI_EMBEDDING_MODEL=gemini-embedding-001

# === デフォルト選択（ここを変えればプロバイダー切替） ===

# -------------------------------------------
# LLM設定（Geminiのみサポート）
# -------------------------------------------
DEFAULT_LLM_PROVIDER=gemini
DEFAULT_LLM_MODEL=gemini-2.5-flash-lite

# -------------------------------------------
# 埋め込みモデル設定
# -------------------------------------------
# プロバイダー: azure_openai | vertex_ai
# モデルはプロバイダーに応じて自動解決:
#   azure_openai → AZURE_OPENAI_EMBEDDING_DEPLOYMENT
#   vertex_ai    → VERTEX_AI_EMBEDDING_MODEL
DEFAULT_EMBEDDING_PROVIDER=azure_openai

# === オプション設定 ===

# -------------------------------------------
# ログレベル（DEBUG | INFO | WARNING | ERROR | CRITICAL）
# -------------------------------------------
# LOG_LEVEL=INFO

# -------------------------------------------
# LLM関連性判定（改定影響調査 run_eval.py 専用）
# -------------------------------------------
# ENABLE_LLM_ANALYSIS=false
