# Anthropic API Configuration
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# OpenAI API Configuration
OPENAI_API_KEY=your_openai_api_key_here

# Google API Configuration
GOOGLE_API_KEY=your_google_api_key_here

# Vertex AI Gemini Configuration
GEMINI_PROJECT_ID=your_gcp_project_id_here
GEMINI_LOCATION=us-central1

# Note: You also need to place 'gemini_credentials.json' in this directory
# Download the service account key from Google Cloud Console

# =============================================================================
# Embedding Provider Configuration
# =============================================================================
# 埋め込みプロバイダーの切り替え: "vertex_ai" (Gemini) or "azure_openai"
# config.py の embedding_provider で設定するか、SearchConfig 初期化時に指定
# EMBEDDING_PROVIDER=vertex_ai

# =============================================================================
# Azure OpenAI Embedding Configuration (text-embedding-3-large)
# =============================================================================
# Azure OpenAI を使用する場合は以下の環境変数を設定してください
AZURE_OPENAI_EMBEDDING_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_EMBEDDING_API_KEY=your_azure_openai_api_key_here
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-large
AZURE_OPENAI_EMBEDDING_API_VERSION=2024-02-01
