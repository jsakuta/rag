# ===========================================
# RAG-Gemini 環境変数設定
# ===========================================
# このファイルを .env にコピーして値を設定してください
#
# 注意: 検索設定（top_k, vector_weight等）は config/settings.yaml で管理
#       ここには機密情報（APIキー等）のみを記載

# -------------------------------------------
# LLM設定（必須）
# -------------------------------------------
# プロバイダー: gemini | anthropic | openai
DEFAULT_LLM_PROVIDER=gemini
# モデル名（例: gemini-2.5-flash-lite, claude-3-5-sonnet-20241022, gpt-4o）
DEFAULT_LLM_MODEL=gemini-2.5-flash-lite

# -------------------------------------------
# 埋め込みモデル設定（必須）
# -------------------------------------------
# プロバイダー: azure_openai | vertex_ai
DEFAULT_EMBEDDING_PROVIDER=azure_openai
# モデル名（例: text-embedding-3-large, gemini-embedding-001）
DEFAULT_EMBEDDING_MODEL=text-embedding-3-large

# -------------------------------------------
# Azure OpenAI設定（埋め込みプロバイダーがazure_openaiの場合必須）
# -------------------------------------------
AZURE_OPENAI_API_KEY=your-api-key-here
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-large
AZURE_OPENAI_API_VERSION=2024-12-01-preview

# -------------------------------------------
# Vertex AI設定（LLMまたは埋め込みでgeminiを使う場合必須）
# -------------------------------------------
GEMINI_PROJECT_ID=your-project-id
GEMINI_LOCATION=us-central1
# 認証情報ファイルのパス（プロジェクトルートからの相対パス）
GEMINI_CREDENTIALS_PATH=gemini_credentials.json

# -------------------------------------------
# Azure Key Vault設定（オプション: Key Vaultから認証情報を取得する場合）
# -------------------------------------------
# AZURE_KEY_VAULT_URL=https://your-keyvault.vault.azure.net/
# AZURE_KEY_VAULT_SECRET_NAME=your-secret-name

# -------------------------------------------
# Anthropic設定（LLMプロバイダーがanthropicの場合必須）
# -------------------------------------------
# ANTHROPIC_API_KEY=your-anthropic-api-key-here

# -------------------------------------------
# OpenAI設定（LLMプロバイダーがopenaiの場合必須）
# -------------------------------------------
# OPENAI_API_KEY=your-openai-api-key-here

# -------------------------------------------
# LLM分析設定（オプション）
# -------------------------------------------
# true: LLM関連性判定を有効化, false: 無効化
ENABLE_LLM_ANALYSIS=true
